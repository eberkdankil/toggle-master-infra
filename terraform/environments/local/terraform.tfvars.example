# Copie para terraform.tfvars (gitignored) e preencha com valores reais.
# Nunca commite o terraform.tfvars preenchido.

master_key = "local-master-key"

# service_api_key já tem um default em variables.tf (semeado no init.sql do
# postgres-auth) — só sobrescreva aqui se você alterar a chave/hash lá também.
